{
  "name": "pcid-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plateau Citizen Identity & Data Exchange Platform (PCID)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/policy",
    "packages/portal-kit",
    "services/api",
    "apps/portal",
    "apps/government",
    "apps/security",
    "apps/emergency"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace services/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace services/api",
    "db:seed": "npm run db:seed --workspace services/api",
    "db:demo": "npm run db:demo --workspace services/api",
    "start:api": "npm run start --workspace services/api",
    "worker:notifications": "npm run worker:notifications --workspace services/api",
    "dev:api": "npm run dev --workspace services/api",
    "openapi": "npm run openapi --workspace services/api",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev:portal": "npm run dev --workspace @pcid/portal",
    "dev:government": "npm run dev --workspace @pcid/government-portal",
    "dev:security": "npm run dev --workspace @pcid/security-portal",
    "dev:emergency": "npm run dev --workspace @pcid/emergency-portal",
    "test:e2e": "npm run test:e2e --workspace @pcid/portal && npm run test:e2e --workspace @pcid/government-portal && npm run test:e2e --workspace @pcid/security-portal && npm run test:e2e --workspace @pcid/emergency-portal"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
