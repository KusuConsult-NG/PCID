# Plateau Citizen Identity & Data Exchange Platform - configuration
#
# Every value here is validated at boot. A missing or malformed value stops the
# process rather than surfacing later as a request-time failure.
#
# Secrets below are placeholders. In any deployed environment they come from the
# platform's secrets manager and are never committed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (§44) ---------------------------------------------------------
# The application connects as a role that is not the owner of any object: it
# cannot alter the schema or delete an audit row. Migrations use a separate
# credential.
DATABASE_URL=postgres://pcid_app:change-me@localhost:5432/pcid
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000
# disable | require | verify-full. Must not be "disable" in production.
DATABASE_SSL=disable
# DATABASE_CA_CERT=/etc/ssl/certs/rds-ca.pem

# --- Shared counters (§45, §63) ---------------------------------------------
# Required in production so rate limits are shared across API instances.
# REDIS_URL=redis://localhost:6379

# --- Key material (§42) -----------------------------------------------------
# Two distinct 32-byte keys, base64url encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_SIGNING_KEY=REPLACE_WITH_32_BYTE_BASE64URL_VALUE_AAAAAAAAAAA
SECRET_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_VALUE_BBBBBB

# --- Session lifetimes ------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
# How long a step-up (AAL2) lasts before sensitive operations require it again.
AAL2_TTL_SECONDS=600

# --- Brute-force protection -------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# --- Rate limiting and search-abuse detection (§63) -------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_SEARCH_MAX=20
SEARCH_VOLUME_ALERT_THRESHOLD=60
SEARCH_VOLUME_WINDOW_SECONDS=3600

# --- Platform ---------------------------------------------------------------
STATE_TIMEZONE=Africa/Lagos
PLATFORM_BASE_URL=http://localhost:3000
VERIFICATION_BASE_URL=http://localhost:3000/verify

# Sandbox integration adapters. MUST be false in production: fixture data must
# not be reachable from a production process (§77, §78).
ALLOW_SANDBOX_ADAPTERS=true

# --- Citizen portal (apps/portal) -------------------------------------------
# A third 32-byte base64url key, distinct from the two above. The portal seals
# the resident's session cookie with it; the API never sees it and the portal
# never sees the API's keys.
PORTAL_SESSION_KEY=REPLACE_WITH_A_THIRD_32_BYTE_VALUE_CCCCCCCC
# Where the portal reaches the API. Server-side only: the browser never calls
# the API directly, so this may be a private address.
PCID_API_URL=http://127.0.0.1:3000
# How long a portal session survives without use, in seconds.
PORTAL_SESSION_TTL_SECONDS=1800

# --- Government portal (apps/government) ------------------------------------
# A fourth 32-byte base64url key, distinct from the other three. Each portal
# seals its own session cookie, so a compromise of one does not produce a usable
# cookie for the other.
GOVERNMENT_PORTAL_SESSION_KEY=REPLACE_WITH_A_FOURTH_32_BYTE_VALUE_DDDDDDD
# Shorter than the citizen portal's. An officer's session is open on a shared
# counter machine, not on their own phone.
GOVERNMENT_PORTAL_SESSION_TTL_SECONDS=900
# The portal's own public origins. A Server Action from anywhere else is refused.
GOVERNMENT_PORTAL_ALLOWED_ORIGINS=http://localhost:3200
